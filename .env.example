# Create Design: configuration. Copy to .env and adjust.
# Every value is read by backend/app/core/config.py; the defaults below are the code defaults.

# --- LLM ---------------------------------------------------------------
# fake | ollama | anthropic. "fake" is scripted and needs nothing (tests, CI, demo mode).
LLM_PROVIDER=fake
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507
# Only for LLM_PROVIDER=anthropic. Never commit a real key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Mock SAP (sap-mock service) ----------------------------------------
SAP_BASE_URL=http://localhost:8100
SAP_USER=demo
SAP_PASSWORD=demo

# --- KiCad ---------------------------------------------------------------
# Path to kicad-cli. On Windows usually:
#   C:\Program Files\KiCad\9.0\bin\kicad-cli.exe
KICAD_CLI=kicad-cli

# --- Storage -------------------------------------------------------------
# Every generated file must resolve inside DESIGNS_ROOT (invariant 3).
DESIGNS_ROOT=./data/designs
# SQLite databases and agent traces.
DATA_DIR=./data

# --- Agent ---------------------------------------------------------------
# Maximum model calls per agent run, the final answer included.
AGENT_MAX_ITERATIONS=6
