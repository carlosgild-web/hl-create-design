# Create Design: configuration. Copy to .env and adjust.
# Every value is read by backend/app/core/config.py; the defaults below are the code defaults.

# --- LLM ---------------------------------------------------------------
# auto | dahl | groq | ollama | demo | fake.
# "auto" (default) checks at startup and uses the first that works: Dahl, then Groq (key set,
#   quota or credit left), then Ollama (running, model pulled), then the demo model.
#   /api/health says which.
# start.cmd / start.sh (local mode) check Dahl, Groq and Ollama first, suggest one and ask which to
#   use (Enter = the suggestion; offers to start Ollama if it is installed but stopped).
#   The choice applies to that run only; this value is where the check starts.
# "demo" is the rule-based demo assistant: no AI, needs nothing (decision 0025).
# "fake" is the scripted test double (tests and CI only).
# "ollama" runs the assistant on your own PC: no key, nothing leaves the machine.
# "dahl" and "groq" are cloud providers, both OpenAI-compatible (decisions 0029, 0012). If one
#   runs out of quota or credit mid-session, the app moves to the next one that works.
LLM_PROVIDER=auto
OLLAMA_BASE_URL=http://localhost:11434
# Pull it once with: ollama pull qwen3:4b-instruct-2507-q4_K_M
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Seconds to wait for one model reply. Raise it (e.g. 600) on a slow or low-RAM CPU.
OLLAMA_TIMEOUT_S=180
# Dahl inference (key from inference.dahl.global/account). Never commit a real key.
# GLM-5.3 Flash answered a real turn with a native tool call; the other two models were at
# capacity for free accounts when checked (2026-11-22).
DAHL_API_KEY=
DAHL_MODEL=zai-org/GLM-5.3-Flash
DAHL_BASE_URL=https://inference.dahl.global/v1
# Groq (key from console.groq.com). Never commit a real key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Frontend ---------------------------------------------------------
# Built UI served by the backend at "/" when this folder exists (the Docker image sets it).
FRONTEND_DIR=./frontend/dist

# --- Mock SAP (sap-mock service) ----------------------------------------
SAP_BASE_URL=http://localhost:8100
SAP_USER=demo
SAP_PASSWORD=demo

# --- Mock SAP: read only by sap-mock (the backend ignores them) ------------
# sap-mock accepts SAP_USER / SAP_PASSWORD above; its database is DATA_DIR/sap_mock.db.
# Pins the mock's date so new numbers keep the demo's year (decision 0007).
# Empty = today's date. The demo uses 2026-11-17.
SAP_TODAY=
# Chaos switches for the demo: delay per request, share of requests answered
# with 503 (0-1), and a maintenance window (every request answers 503).
SAP_LATENCY_MS=0
SAP_FAIL_RATE=0
SAP_MAINTENANCE=false

# --- KiCad ---------------------------------------------------------------
# Path to kicad-cli (KiCad 9). On Windows usually one of:
#   C:\Program Files\KiCad\9.0\bin\kicad-cli.exe                 (all users)
#   C:\Users\<you>\AppData\Local\Programs\KiCad\9.0\bin\kicad-cli.exe  (winget, current user)
# Without KiCad, use `create-design --no-export`.
KICAD_CLI=kicad-cli
# "Open in KiCad" in the preview starts the KiCad GUI found next to KICAD_CLI, on the
# machine that runs the backend. Leave true locally; Docker sets it to false.
KICAD_OPEN_ENABLED=true

# --- Storage -------------------------------------------------------------
# Every generated file must resolve inside DESIGNS_ROOT (invariant 3).
# Relative paths are relative to the repo root, not the working directory.
DESIGNS_ROOT=./data/designs
# SQLite databases and agent traces.
DATA_DIR=./data

# --- Agent ---------------------------------------------------------------
# Maximum model calls per agent run, the final answer included.
AGENT_MAX_ITERATIONS=6
# Seconds for one whole answer (all model calls, rate-limit waits included). Then the chat
# says so and offers to switch to Ollama or the demo model.
AGENT_TURN_TIMEOUT_S=120
# Search the Design Manual before the first model call: auto (questions only), on, off.
AGENT_PRERETRIEVAL=auto
# Ollama only: one short example answer in the prompt (for a small model; off by default).
AGENT_FEW_SHOT=false

# --- Public demo safety (0 = off; the online demo sets them, Phase 7) -----------
# State-changing requests (chat turns, card clicks) allowed per IP per minute.
RATE_LIMIT_PER_MIN=0
# Model tokens per UTC day for all users together; the assistant pauses at the cap.
DAILY_TOKEN_CAP=0
# Delete generated design folders older than this many hours (hourly job; also
# `python -m app.cli cleanup --older-than HOURS`).
DESIGNS_TTL_HOURS=0
# Behind a proxy (Hugging Face Spaces): read the client IP from X-Forwarded-For.
TRUST_FORWARDED_FOR=false
