{
  "video": "demo",
  "provider": "demo",
  "banner": "Scripted model (rules) — DemoClient",
  "notes": [
    "The storyboard rows as data (Claude outputs/create-design-video-storyboard.md, decision 0028).",
    "turn: the sentence whose chat events a row matches; by default the one of the last typed:<key> step before it. on.step: shown when record.spec.ts reaches that step. on.event: shown when that captured event arrives; phase 'before' shows it while the event is held, 'after' once the app has it. on.follow: right after the previous row.",
    "payload.from: event | request | confirm | action | trace | introspect:fts | introspect:intent; payload.pick is a dotted path into it. Payloads are only ever taken from the take's own capture."
  ],
  "sentences": {
    "question": "Why was revision I rejected?",
    "fill": "Revision C of HL-HW-26-0003, Bead Sorter Vision Board, designer C. Velazquez",
    "fill_wrong": "Revision I of HL-HW-26-0003, Bead Sorter Vision Board, designer C. Velazquez",
    "reserve": "Reserve a Hardware number for Bead Polisher Controller, designer C. Velazquez.",
    "description": "Polishing station controller, first release"
  },
  "rows": [
    { "id": "0.1", "scene": 0, "on": { "step": "title" }, "slide": "title",
      "subtitle": "Create Design is an assistant that helps an engineer create a KiCad design with a SAP number." },
    { "id": "0.2", "scene": 0, "on": { "step": "map" }, "slide": "map",
      "subtitle": "The AI guides. The code decides. Every check, number and file is done by plain code." },
    { "id": "0.3", "scene": 0, "on": { "step": "invariants" }, "slide": "invariants",
      "subtitle": "Three rules matter for this video: the model never has side effects, the user confirms, and every step is traced." },

    { "id": "1.1", "scene": 1, "on": { "step": "typed:question" }, "layer": "Browser",
      "subtitle": "An engineer asks a question in the chat.",
      "callouts": [["frontend/src/hooks/useChat.ts", "useChat.send"]] },
    { "id": "1.2", "scene": 1, "on": { "event": "request" }, "layer": "Browser",
      "subtitle": "The browser sends the text and the form fields as JSON: POST /api/chat.",
      "callouts": [["backend/app/api/chat.py", "ChatRequest"]], "payload": { "from": "request" } },
    { "id": "1.3", "scene": 1, "on": { "event": "conversation" }, "layer": "FastAPI",
      "subtitle": "FastAPI opens a Server-Sent Events stream. Events will arrive one by one.",
      "callouts": [["backend/app/api/chat.py", "sse"], ["backend/app/api/chat.py", "chat"]], "payload": { "from": "event" } },
    { "id": "1.4", "scene": 1, "on": { "event": "run" }, "layer": "Agent loop",
      "subtitle": "The backend creates a conversation and a run, and builds the first messages.",
      "callouts": [["backend/app/agent/service.py", "chat_turn"], ["backend/app/agent/prompts.py", "SYSTEM_PROMPT"]], "payload": { "from": "event" } },
    { "id": "1.5", "scene": 1, "on": { "follow": true }, "layer": "Agent loop",
      "subtitle": "A tiny classifier looks at the sentence. A question mark means: this is about the manual.",
      "callouts": [["backend/app/agent/intent.py", "classify"], ["backend/app/agent/service.py", "preretrieval_for"]], "payload": { "from": "introspect:intent" } },
    { "id": "1.6", "scene": 1, "on": { "event": "tool_call", "name": "search_design_manual", "auto": true }, "layer": "Tools",
      "subtitle": "Before the model speaks, the backend searches the Design Manual itself. This is called pre-retrieval.",
      "callouts": [["backend/app/agent/loop.py", "_run"]], "payload": { "from": "event" } },
    { "id": "1.7", "scene": 1, "on": { "follow": true }, "layer": "Manual",
      "subtitle": "Not a vector database: SQLite full-text search. Words are stemmed, then ranked with BM25.",
      "callouts": [["backend/app/standards/manual_search.py", "fts_query"], ["backend/app/standards/manual_search.py", "ManualIndex.search"]], "payload": { "from": "introspect:fts" } },
    { "id": "1.8", "scene": 1, "on": { "event": "tool_result", "name": "search_design_manual", "auto": true }, "layer": "Manual",
      "subtitle": "The best match is an FAQ entry whose heading is the same question. Headings weigh 3x.",
      "callouts": [["docs/manual/en/07-faq.md", "Why was revision I rejected?"]], "payload": { "from": "event", "pick": "result.passages.0" } },
    { "id": "1.9", "scene": 1, "on": { "follow": true }, "layer": "Agent loop",
      "subtitle": "The result goes into the conversation as a tool message, exactly as the model will read it.",
      "callouts": [["backend/app/agent/loop.py", "_execute"], ["backend/app/agent/service.py", "OLLAMA_SEARCH_LIMIT"]], "payload": { "from": "event", "pick": "result" } },
    { "id": "1.10", "scene": 1, "on": { "event": "message", "phase": "before" }, "layer": "Model",
      "subtitle": "Now the model is called with the question and the passages.",
      "callouts": [["backend/app/agent/loop.py", "_model_call"], ["backend/app/llm/base.py", "LLMClient.chat"]] },
    { "id": "1.11", "scene": 1, "on": { "follow": true }, "layer": "Model",
      "subtitle": "The demo model takes the top passage and cites it. Ollama or Groq would write the reply by reading the passages.",
      "callouts": [["backend/app/llm/demo.py", "DemoClient.chat"], ["backend/app/llm/demo.py", "_snippet"]] },
    { "id": "1.12", "scene": 1, "on": { "event": "message" }, "layer": "Browser",
      "subtitle": "The answer comes back as one more SSE event, with a citation to the manual.",
      "callouts": [["frontend/src/api/sse.ts", "parseSse"], ["frontend/src/hooks/useChat.ts", "useChat.handle"]], "payload": { "from": "event" } },
    { "id": "1.13", "scene": 1, "on": { "step": "citation" }, "layer": "Browser",
      "subtitle": "Every answer points to the exact manual section.",
      "callouts": [["frontend/src/components/ManualRef.tsx", "ManualRef"]] },
    { "id": "1.14", "scene": 1, "on": { "step": "drawer" }, "layer": "Browser",
      "subtitle": "Nothing is hidden: every tool call and its result is traced and visible.",
      "callouts": [["backend/app/agent/trace.py", "AgentTrace"], ["backend/app/api/chat.py", "get_run"]], "payload": { "from": "trace", "pick": "trace.steps.0" } },

    { "id": "2.1", "scene": 2, "on": { "step": "typed:fill" }, "layer": "Browser",
      "subtitle": "The engineer describes the design in plain words.",
      "callouts": [["frontend/src/hooks/useChat.ts", "useChat.send"]] },
    { "id": "2.2", "scene": 2, "on": { "event": "run" }, "layer": "Agent loop",
      "subtitle": "This is not a question, so no manual search is needed.",
      "callouts": [["backend/app/agent/intent.py", "classify"]], "payload": { "from": "introspect:intent" } },
    { "id": "2.3", "scene": 2, "on": { "event": "tool_call", "name": "propose_form_values", "phase": "before" }, "layer": "Model",
      "subtitle": "The model has to decide: which tool do I need?",
      "callouts": [["backend/app/llm/demo.py", "DemoClient.chat"]] },
    { "id": "2.4", "scene": 2, "on": { "follow": true }, "layer": "Model",
      "subtitle": "The demo model extracts the fields with rules. Ollama would return a JSON tool_calls list.",
      "callouts": [["backend/app/llm/demo.py", "extract_fields"], ["backend/app/llm/ollama.py", "OllamaClient.chat"]] },
    { "id": "2.5", "scene": 2, "on": { "event": "tool_call", "name": "propose_form_values" }, "layer": "Tools",
      "subtitle": "It calls a tool. The call is just a name and arguments.",
      "callouts": [["backend/app/agent/tools.py", "propose_form_values"], ["backend/app/agent/tools.py", "ToolRegistry.execute"]], "payload": { "from": "event" } },
    { "id": "2.8", "scene": 2, "on": { "event": "form_proposal" }, "layer": "Browser",
      "subtitle": "The result is a form proposal. The form fills itself, and the engineer can still edit it.",
      "callouts": [["backend/app/agent/loop.py", "_execute"], ["frontend/src/hooks/useChat.ts", "useChat.handle"]], "payload": { "from": "event" } },
    { "id": "2.6", "scene": 2, "on": { "event": "tool_call", "name": "validate_design_request" }, "layer": "Tools",
      "subtitle": "Then it asks the validators to check the values.",
      "callouts": [["backend/app/agent/tools.py", "validate_design_request"], ["backend/app/designs.py", "check_fields"]], "payload": { "from": "event", "pick": "arguments" } },
    { "id": "2.7", "scene": 2, "on": { "event": "tool_result", "name": "validate_design_request" }, "layer": "Validators",
      "subtitle": "The model does not decide if values are valid. These functions do.",
      "callouts": [["backend/app/standards/validators.py", "validate_revision"], ["backend/app/standards/validators.py", "check_status_allows_revision"], ["backend/app/standards/validators.py", "validate_designer"]], "payload": { "from": "event", "pick": "result" } },
    { "id": "2.9", "scene": 2, "turn": "fill_wrong", "on": { "event": "tool_result", "name": "validate_design_request", "code": "rev_skipped_letter" }, "layer": "Validators",
      "subtitle": "Same sentence, revision I: the validator returns an error code and a manual reference, not prose.",
      "callouts": [["backend/app/standards/validators.py", "validate_revision"]], "payload": { "from": "event", "pick": "result.errors" } },
    { "id": "2.10", "scene": 2, "turn": "fill_wrong", "on": { "event": "message" }, "layer": "Model",
      "subtitle": "The model now explains the result in words. It cannot change it.",
      "callouts": [["backend/app/llm/demo.py", "DemoClient._after_validation"]], "payload": { "from": "event" } },

    { "id": "3.1", "scene": 3, "on": { "step": "typed:reserve" }, "layer": "Browser",
      "subtitle": "Now a new design. Same start: fill the form and validate.",
      "callouts": [["backend/app/agent/tools.py", "propose_form_values"], ["backend/app/agent/tools.py", "validate_design_request"]] },
    { "id": "3.2", "scene": 3, "on": { "event": "tool_call", "name": "request_reserve_number" }, "layer": "Tools",
      "subtitle": "The values are valid, so the model asks to reserve a number. It cannot do it.",
      "callouts": [["backend/app/agent/tools.py", "request_reserve_number"]], "payload": { "from": "event" } },
    { "id": "3.3", "scene": 3, "on": { "event": "tool_result", "name": "request_reserve_number" }, "layer": "Tools",
      "subtitle": "The tool only opens a card: it writes a pending action row and returns. No SAP call happens here.",
      "callouts": [["backend/app/agent/tools.py", "_open_card"], ["backend/app/db/store.py", "create_action"]], "payload": { "from": "event", "pick": "result" } },
    { "id": "3.4", "scene": 3, "on": { "event": "pending_action" }, "layer": "Browser",
      "subtitle": "The user sees exactly what will happen, and decides.",
      "callouts": [["frontend/src/components/ActionCard.tsx", "ActionCard"]], "payload": { "from": "event" } },
    { "id": "3.5", "scene": 3, "on": { "event": "done" }, "layer": "Agent loop",
      "subtitle": "The run is over. The server has done nothing irreversible.",
      "callouts": [["backend/app/agent/loop.py", "_run"]], "payload": { "from": "event" } },
    { "id": "3.6", "scene": 3, "on": { "follow": true }, "layer": "Browser",
      "subtitle": "Confirmation gate: side effects only happen in a separate endpoint, triggered by a click.",
      "callouts": [["CLAUDE.md", "Invariants"]] },

    { "id": "4.1", "scene": 4, "on": { "event": "confirm", "kind": "reserve_number", "phase": "before" }, "layer": "FastAPI",
      "subtitle": "The click calls a normal REST endpoint, not the model.",
      "callouts": [["backend/app/api/actions.py", "confirm"], ["backend/app/actions.py", "confirm_action"]] },
    { "id": "4.2", "scene": 4, "on": { "follow": true }, "layer": "FastAPI",
      "subtitle": "The action is claimed once, so a double click cannot reserve two numbers.",
      "callouts": [["backend/app/db/store.py", "claim_action"]] },
    { "id": "4.3", "scene": 4, "on": { "follow": true }, "layer": "Validators",
      "subtitle": "The values are checked again right now, because things could have changed.",
      "callouts": [["backend/app/actions.py", "_reserve"]] },
    { "id": "4.4", "scene": 4, "on": { "follow": true }, "layer": "SAP",
      "subtitle": "The only door to SAP is SapClient.",
      "callouts": [["backend/app/sap/client.py", "SapClient.reserve_number"]] },
    { "id": "4.5", "scene": 4, "on": { "follow": true }, "layer": "SAP",
      "subtitle": "The client gets a CSRF token, then POSTs the design. SAP replies with the number, the material and the WBS.",
      "callouts": [["backend/app/sap/client.py", "SapClient._post"]], "payload": { "from": "confirm", "pick": "result" } },
    { "id": "4.6", "scene": 4, "on": { "follow": true }, "layer": "FastAPI",
      "subtitle": "Every reserved number is recorded in the audit log.",
      "callouts": [["backend/app/db/session.py", "write_audit"]] },
    { "id": "4.7", "scene": 4, "on": { "event": "confirm", "kind": "reserve_number" }, "layer": "Browser",
      "subtitle": "The number comes back to the chat and the form. The fields SAP owns are locked.",
      "callouts": [["frontend/src/components/SapCard.tsx", "SapCard"]], "payload": { "from": "confirm" } },
    { "id": "4.8", "scene": 4, "on": { "event": "action", "kind": "create_design" }, "layer": "Browser",
      "subtitle": "Creating the files is a second confirmed action. The form button also goes through a card.",
      "callouts": [["backend/app/actions.py", "_create"]], "payload": { "from": "action", "pick": "payload" } },
    { "id": "4.9", "scene": 4, "on": { "event": "confirm", "kind": "create_design", "phase": "before" }, "layer": "FastAPI",
      "subtitle": "Every file path is resolved inside the designs folder. '..', absolute paths and escaping symlinks are rejected.",
      "callouts": [["backend/app/standards/validators.py", "resolve_inside"], ["backend/app/designs.py", "create_design"]], "payload": { "from": "confirm", "pick": "result.folder" } },
    { "id": "4.10", "scene": 4, "on": { "event": "confirm", "kind": "create_design" }, "layer": "Browser",
      "subtitle": "KiCad exports the PDF with the title block filled, and the preview opens.",
      "callouts": [["backend/app/kicad/exporter.py", "export_schematic"], ["frontend/src/components/PreviewDialog.tsx", "PreviewDialog"]], "payload": { "from": "confirm", "pick": "result" } },
    { "id": "4.11", "scene": 4, "on": { "step": "open_kicad" }, "layer": "Browser",
      "subtitle": "The last click asks the backend to open the project in KiCad on this PC. It writes no file and is audited.",
      "callouts": [["backend/app/api/designs.py", "open_in_kicad"]] },

    { "id": "5.1", "scene": 5, "on": { "step": "trace" }, "slide": "trace",
      "subtitle": "One run, one trace: model calls, tool calls, arguments, and results exactly as the model saw them.",
      "payload": { "from": "trace" } },
    { "id": "5.2", "scene": 5, "on": { "follow": true }, "slide": "trace",
      "subtitle": "A run is bounded by AGENT_MAX_ITERATIONS, so it cannot loop forever.",
      "callouts": [["backend/app/agent/loop.py", "run_agent"]] },
    { "id": "6.1", "scene": 6, "on": { "step": "compare" }, "slide": "compare",
      "subtitle": "Only one thing is swapped: who decides which tool to call. Everything around it is the same code.",
      "callouts": [["backend/app/llm/ollama.py", "_calls_from_text"]] },
    { "id": "7.1", "scene": 7, "on": { "step": "close" }, "slide": "close",
      "subtitle": "The AI guides. The code decides. The user clicks." }
  ]
}
